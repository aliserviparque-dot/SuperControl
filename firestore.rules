rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuración — solo lectura pública, escritura con autenticación
    match /config/{docId} {
      allow read: if true;
      allow write: if true; // En producción: cambiar a autenticación
    }

    // Supervisores
    match /supervisores/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Cajeras
    match /cajeras/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Personal de baños
    match /personal_banos/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Preguntas cajas
    match /preguntas_cajera/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Preguntas baños
    match /preguntas_bano/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Reportes — cualquiera puede crear, solo admin puede leer todos
    match /reportes/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
